#!/usr/bin/env bash
# Source this file after activating the environment and before running the agent.

export SYMMCD_ROOT=/ABSOLUTE/PATH/SymmBand-Agent
export PYDANTIC_AI_SOURCE=/ABSOLUTE/PATH/SymmBand-Agent/vendor/pydantic-ai
export BAND_ANALYZER_ROOT=/ABSOLUTE/PATH/SymmBand-Agent/band_analysis
export BAND_PYTHON="${CONDA_PREFIX}/bin/python"
export BAND_OUTPUT_ROOT=/ABSOLUTE/PATH/SymmBand-Agent/band-results

export ATOMATE2_CONFIG_FILE=/ABSOLUTE/PATH/SymmBand-Agent/cluster_environment/config/atomate2.yaml
export JOBFLOW_CONFIG_FILE=/ABSOLUTE/PATH/SymmBand-Agent/cluster_environment/config/jobflow.yaml
export PMG_VASP_PSP_DIR=/ABSOLUTE/PATH/vasp-potcar-root

# The directory containing the irvsp executable must be on PATH.
export PATH=/ABSOLUTE/PATH/irvsp/bin:${PATH}

# Avoid CPU oversubscription inside one MPI rank.
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}
