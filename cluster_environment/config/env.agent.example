# Copy this file to <SYMMCD_ROOT>/.env.agent and replace every /ABSOLUTE/PATH value.

# DeepSeek OpenAI-compatible API
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=replace-with-your-deepseek-key

# Adjacent source checkout
PYDANTIC_AI_SOURCE=/ABSOLUTE/PATH/SymmBand-Agent/vendor/pydantic-ai

# Local inference assets. A local MACE model avoids downloads on compute nodes.
MACE_MODEL=/ABSOLUTE/PATH/SymmBand-Agent/macemodel/2023-12-03-mace-128-L1_epoch-199.model
MACE_DEVICE=cuda
STRUCTURE_INPUT_DIR=/ABSOLUTE/PATH/SymmBand-Agent/input_structures
ENERGY_OUTPUT_ROOT=/ABSOLUTE/PATH/SymmBand-Agent/calculation_results/mace_energy
CALCULATION_RESULTS_ROOT=/ABSOLUTE/PATH/SymmBand-Agent/calculation_results

# Band workflow
BAND_ANALYZER_ROOT=/ABSOLUTE/PATH/SymmBand-Agent/band_analysis
BAND_PYTHON=/ABSOLUTE/PATH/miniconda/envs/symmcd-band-agent/bin/python
BAND_OUTPUT_ROOT=/ABSOLUTE/PATH/SymmBand-Agent/band-results
BAND_TIMEOUT_SECONDS=0
