# DeepSeek OpenAI-compatible API
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-your-deepseek-key
LLM_MODEL=deepseek-v4-flash

# Local inference assets
MACE_MODEL=macemodel/2023-12-03-mace-128-L1_epoch-199.model
MACE_DEVICE=cuda
# PYDANTIC_AI_SOURCE defaults to vendor/pydantic-ai.

# Band workflow integration
# BAND_ANALYZER_ROOT defaults to band_analysis.
# BAND_PYTHON defaults to the current Python executable.
BAND_OUTPUT_ROOT=band-results
BAND_TIMEOUT_SECONDS=0
